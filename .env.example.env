###########################################
# Localização
###########################################

TZ=Europe/Rome
PUID=1000
PGID=1000
UMASK=002
DOMAIN=''

###########################################
# Diretórios
###########################################

ROOT_PATH=/srv/docker/media

CONFIG_PATH=${ROOT_PATH}/config
CACHE_PATH=${ROOT_PATH}/cache
DATA_PATH=${ROOT_PATH}/data
BACKUP_PATH=${ROOT_PATH}/backups

###########################################
# Docker Networks
###########################################

# no projeto atual nao usada, mas se desejar pode transformar a network
# em variáveis
MEDIA_NETWORK=media 

###########################################
# VPN (Gluetun)
###########################################

VPN_SERVICE_PROVIDER=custom 
VPN_TYPE=wireguard

# chave gerada no computador do Gluetun

WIREGUARD_PRIVATE_KEY=


#dados da VPS

WIREGUARD_ADDRESSES=
WIREGUARD_PUBLIC_KEY=
WIREGUARD_ENDPOINT_IP=
WIREGUARD_ENDPOINT_PORT=

VPN_COUNTRY=CUSTOM

###########################################
